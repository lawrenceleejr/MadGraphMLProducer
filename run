#!/bin/bash
# MadGraphMLProducer - Single command event generation
#
# Usage:
#   ./run                              # Default config with auto-named output
#   ./run -n 50000                     # Generate 50k events
#   ./run -o my_output.h5              # Custom output file
#   ./run -c /path/to/config.yaml      # Custom config
#   ./run --help                       # Show all options

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
IMAGE_NAME="madgraph-ml-producer"
IMAGE_TAG="latest"

# Check if Docker is available
if ! command -v docker &> /dev/null; then
    echo "Error: Docker is not installed or not in PATH"
    echo "Please install Docker: https://docs.docker.com/get-docker/"
    exit 1
fi

# Build image if it doesn't exist or if --rebuild is passed
BUILD_IMAGE=false
if [[ "$*" == *"--rebuild"* ]]; then
    BUILD_IMAGE=true
    # Remove --rebuild from arguments
    set -- "${@/--rebuild/}"
fi

if ! docker image inspect ${IMAGE_NAME}:${IMAGE_TAG} &> /dev/null || [ "$BUILD_IMAGE" = true ]; then
    echo "Building Docker image (this may take a few minutes on first run)..."
    if [ "$BUILD_IMAGE" = true ]; then
        # Force full rebuild with --no-cache when --rebuild is specified
        docker build --no-cache -t ${IMAGE_NAME}:${IMAGE_TAG} "$SCRIPT_DIR"
    else
        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} "$SCRIPT_DIR"
    fi
    echo "Docker image built successfully!"
    echo ""
fi

# Parse arguments to handle output path and config path
OUTPUT_DIR=""
OUTPUT_FILE=""
CONFIG_PATH=""
CONFIG_NAME=""
NUM_EVENTS=""
REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -o|--output)
            OUTPUT_FILE="$2"
            shift 2
            ;;
        -c|--config)
            CONFIG_PATH="$2"
            shift 2
            ;;
        -n|--events)
            NUM_EVENTS="$2"
            REMAINING_ARGS+=("-n" "$2")
            shift 2
            ;;
        *)
            REMAINING_ARGS+=("$1")
            shift
            ;;
    esac
done

# Determine config name for auto-naming
if [ -n "$CONFIG_PATH" ]; then
    if [ -f "$CONFIG_PATH" ]; then
        CONFIG_NAME=$(basename "$CONFIG_PATH" .yaml)
    else
        echo "Error: Config file not found: $CONFIG_PATH"
        exit 1
    fi
else
    CONFIG_NAME="gluino_rpv_1tev"
fi

# Generate timestamp
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

# Set default output directory and file if not specified
if [ -z "$OUTPUT_FILE" ]; then
    OUTPUT_DIR="${SCRIPT_DIR}/output"
    mkdir -p "$OUTPUT_DIR"

    # Auto-generate filename: configname_nevents_timestamp.h5
    if [ -n "$NUM_EVENTS" ]; then
        OUTPUT_FILE="${CONFIG_NAME}_${NUM_EVENTS}evt_${TIMESTAMP}.h5"
    else
        OUTPUT_FILE="${CONFIG_NAME}_${TIMESTAMP}.h5"
    fi
else
    # User specified output file
    if [[ "$OUTPUT_FILE" == */* ]]; then
        # Path included
        OUTPUT_DIR="$(cd "$(dirname "$OUTPUT_FILE")" 2>/dev/null && pwd || mkdir -p "$(dirname "$OUTPUT_FILE")" && cd "$(dirname "$OUTPUT_FILE")" && pwd)"
        OUTPUT_FILE="$(basename "$OUTPUT_FILE")"
    else
        # Just filename, use default output dir
        OUTPUT_DIR="${SCRIPT_DIR}/output"
        mkdir -p "$OUTPUT_DIR"
    fi
fi

# Build docker run command
DOCKER_CMD="docker run --rm"

# Run as current user to avoid permission issues with output files
DOCKER_CMD+=" --user $(id -u):$(id -g)"

# Mount output directory
DOCKER_CMD+=" -v ${OUTPUT_DIR}:/output"

# Handle config file mounting
if [ -n "$CONFIG_PATH" ]; then
    CONFIG_DIR="$(cd "$(dirname "$CONFIG_PATH")" && pwd)"
    CONFIG_FILE="$(basename "$CONFIG_PATH")"
    DOCKER_CMD+=" -v ${CONFIG_DIR}:/config:ro"
    REMAINING_ARGS+=("-c" "/config/${CONFIG_FILE}")
fi

# Add output path
REMAINING_ARGS+=("-o" "/output/${OUTPUT_FILE}")

# Run the container
DOCKER_CMD+=" ${IMAGE_NAME}:${IMAGE_TAG} ${REMAINING_ARGS[*]}"

echo "Running event generation..."
echo "Output will be: ${OUTPUT_DIR}/${OUTPUT_FILE}"
echo ""
eval $DOCKER_CMD

echo ""
echo "Output file: ${OUTPUT_DIR}/${OUTPUT_FILE}"
