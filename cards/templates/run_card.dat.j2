#************************************************************
#*                     MadGraph5_aMC@NLO                    *
#*                                                          *
#*                  Run Card (auto-generated)               *
#*                                                          *
#************************************************************
# Generated by MadGraphMLProducer
# Configuration: {{ config.name }}
#
#************************************************************
#*                      Run Parameters                       *
#************************************************************

#*********************************************************************
# Tag name for the run (one word)                                    *
#*********************************************************************
  tag_1 = run_tag ! name of the run

#*********************************************************************
# Number of events and random seed                                   *
#*********************************************************************
  {{ config.generation.num_events }} = nevents ! Number of unweighted events requested
  {{ config.generation.random_seed }} = iseed   ! rnd seed (0=assigned automatically=default))

#*********************************************************************
# Collider type and target particle                                  *
#*********************************************************************
  {{ config.collider.beam1_pdg }} = lpp1    ! beam 1 type (0=photon, 1=proton, -1=antiproton)
  {{ config.collider.beam2_pdg }} = lpp2    ! beam 2 type
  {{ config.collider.energy_beam1 }} = ebeam1  ! beam 1 total energy in GeV
  {{ config.collider.energy_beam2 }} = ebeam2  ! beam 2 total energy in GeV

#*********************************************************************
# PDF CHOICE: Use built-in (internal) or LHAPDF (external) PDF       *
#*********************************************************************
  lhapdf = pdlabel     ! PDF set
  $DEFAULT_PDF_MEMBERS = lhaid ! PDF set member ID

#*********************************************************************
# Renormalization and factorization scales                           *
#*********************************************************************
  False = fixed_ren_scale  ! if .true. use fixed ren scale
  False = fixed_fac_scale  ! if .true. use fixed fac scale
  91.188 = scale            ! fixed ren scale
  91.188 = dsqrt_q2fact1    ! fixed fact scale for pdf1
  91.188 = dsqrt_q2fact2    ! fixed fact scale for pdf2
  -1 = dynamical_scale_choice ! 1=HT, 2=HT/2, 3=sqrt(s), 4=sum(pt)

#*********************************************************************
# Matching - MLM                                                     *
#*********************************************************************
{% if config.matching.enabled and config.matching.scheme == 'mlm' %}
  1 = ickkw            ! 0=no matching, 1=MLM matching
  {{ "%.1f"|format(config.matching.xqcut) }} = xqcut   ! minimum kt jet measure between partons
  {{ config.matching.max_jet_flavor }} = maxjetflavor    ! max parton flavor used for the matching
  1.0 = alpsfact        ! scale factor for QCD emission
{% else %}
  0 = ickkw            ! 0=no matching
{% endif %}

#*********************************************************************
# Cuts on particles                                                   *
#*********************************************************************
{% if config.matching.enabled %}
# When using MLM matching, generation-level cuts are typically set to 0
# The matching procedure handles the jet definition
  0.0 = ptj       ! minimum pt for the jets
  0.0 = ptb       ! minimum pt for the b
  -1.0 = ptl      ! minimum pt for leptons
  0.0 = etaj      ! max rapidity for jets
  0.0 = etab      ! max rapidity for b
  -1.0 = etal     ! max rapidity for leptons
  0.0 = drjj      ! min deltaR(j,j)
  0.0 = drbb      ! min deltaR(b,b)
  0.0 = drll      ! min deltaR(l,l)
  0.0 = drjl      ! min deltaR(j,l)
{% else %}
# Standard generation cuts (no matching)
  {{ "%.1f"|format(config.generation.ptj_min) }} = ptj       ! minimum pt for the jets
  20.0 = ptb       ! minimum pt for the b
  {{ "%.1f"|format(config.generation.ptl_min) }} = ptl       ! minimum pt for leptons
  {{ "%.1f"|format(config.generation.etaj_max) }} = etaj     ! max rapidity for jets
  5.0 = etab      ! max rapidity for b
  {% if config.generation.etal_max > 0 %}{{ "%.1f"|format(config.generation.etal_max) }}{% else %}-1.0{% endif %} = etal     ! max rapidity for leptons
  {{ "%.2f"|format(config.generation.drjj_min) }} = drjj      ! min deltaR(j,j)
  0.0 = drbb      ! min deltaR(b,b)
  0.0 = drll      ! min deltaR(l,l)
  0.0 = drjl      ! min deltaR(j,l)
{% endif %}

#*********************************************************************
# Mass cuts                                                          *
#*********************************************************************
  0.0 = mmjj    ! min invariant mass of a jet pair
  0.0 = mmbb    ! min invariant mass of a b pair
  0.0 = mmll    ! min invariant mass of l+l-

#*********************************************************************
# Photon isolation                                                    *
#*********************************************************************
  0.4 = ptgmin    ! minimum pt for photon
  -1.0 = etagamma ! max rapidity for photon
  0.4 = r0gamma   ! photon isolation cone

#*********************************************************************
# Heavy particle cuts                                                 *
#*********************************************************************
  0.0 = ptheavy ! minimum pt for heavy particles (H, Z, W, T, B, ...)

#*********************************************************************
# Systematics                                                         *
#*********************************************************************
  {{ config.generation.use_syst | string }} = use_syst      ! Enable systematics studies

#*********************************************************************
# BW treatment                                                        *
#*********************************************************************
  True = bwcutoff  ! Apply cutoff for Breit-Wigner
  15.0 = bwcutoff_value ! BW cutoff value in units of width
