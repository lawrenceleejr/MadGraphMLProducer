! ************************************************************
! *                     Pythia8 Configuration                *
! *                                                          *
! *          Parton Shower with MLM Jet Matching             *
! *                                                          *
! ************************************************************
! Generated by MadGraphMLProducer
! Configuration: {{ config.name }}

! ============================================================
! Basic Run Settings
! ============================================================
Main:numberOfEvents = {{ config.generation.num_events }}
Random:setSeed = on
{% if config.generation.random_seed > 0 %}
Random:seed = {{ config.generation.random_seed + 1 }}
{% else %}
Random:seed = 0
{% endif %}

! ============================================================
! Beam Configuration (read from LHE file)
! ============================================================
Beams:frameType = 4
! Beams:LHEF will be set by the runner script

! ============================================================
! MLM Jet Matching Configuration
! ============================================================
{% if config.matching.enabled and config.matching.scheme == 'mlm' %}
! Enable MLM matching (MadGraph-style)
JetMatching:merge = on
JetMatching:scheme = 1
JetMatching:setMad = on
JetMatching:qCut = {{ "%.1f"|format(config.matching.qcut) }}
JetMatching:nQmatch = {{ config.matching.max_jet_flavor }}
JetMatching:nJetMax = {{ config.process.extra_partons }}
JetMatching:doShowerKt = off
JetMatching:coneRadius = 1.0
JetMatching:etaJetMax = 100.0
{% elif config.matching.enabled and config.matching.scheme == 'ckkw-l' %}
! Enable CKKW-L matching
Merging:doKTMerging = on
Merging:TMS = {{ "%.1f"|format(config.matching.xqcut) }}
Merging:nJetMax = {{ config.process.extra_partons }}
Merging:Process = {{ config.process.process_string }}
{% else %}
! No jet matching
JetMatching:merge = off
{% endif %}

! ============================================================
! Parton Shower Settings
! ============================================================
! Initial State Radiation
PartonLevel:ISR = on
SpaceShower:QCDshower = on
SpaceShower:QEDshowerByQ = on
SpaceShower:QEDshowerByL = on

! Final State Radiation
PartonLevel:FSR = on
TimeShower:QCDshower = on
TimeShower:QEDshowerByQ = on
TimeShower:QEDshowerByL = on

! Multiple Parton Interactions
PartonLevel:MPI = on
MultipartonInteractions:pT0Ref = 2.28

! ============================================================
! Hadronization Settings
! ============================================================
HadronLevel:Hadronize = on
StringZ:aLund = 0.68
StringZ:bLund = 0.98
StringPT:sigma = 0.335
StringFlav:probStoUD = 0.217

! ============================================================
! Particle Decays
! ============================================================
ParticleDecays:limitTau0 = on
ParticleDecays:tau0Max = 10.0
! Let particles with ctau < 10mm decay

! Specific particle handling
{% if config.process.model == "RPVMSSM_UFO" or "MSSM" in config.process.model %}
! SUSY particle decays handled by MadGraph/LHE
! Ensure Pythia respects the decay chain from LHE
{% endif %}

! ============================================================
! Tune Selection
! ============================================================
! Use Monash 2013 tune (default for Pythia 8.2+)
Tune:pp = 14
Tune:ee = 7

! ============================================================
! Output Settings
! ============================================================
! Print settings
Init:showChangedSettings = on
Init:showChangedParticleData = off
Next:numberShowEvent = 0
Next:numberShowProcess = 0
Next:numberShowInfo = 0

! ============================================================
! Processing Control
! ============================================================
! Allow events to fail matching (will be vetoed)
Check:abortIfVeto = off
Check:epTolErr = 0.01
